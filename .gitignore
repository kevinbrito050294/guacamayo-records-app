# Este archivo TIENE que estar en UTF-8. Estava guardado en UTF-16 y git no leia
# ni un solo patron (por eso .env se pudo commitear igual, "estaba en .gitignore").
node_modules/
dist/

# Archivos de entorno reales: nunca se commitean. .env.* cubre .env.production,
# .env.local, .env.development, etc. Railway inyecta las variables directamente;
# ignorar estos archivos no afecta ese mecanismo.
.env
.env.*

# ...menos la plantilla, que si va al repo: es la unica documentacion de que
# claves existen. Tiene que ir DESPUES de .env.* porque si no, no se re-incluye.
!.env.example

# Firma privada de los APK release: nunca subirla al repositorio.
*.jks
*.keystore
GUACAMAYO_KEYSTORE_*
android/app/google-services.json
android/.idea/

# Artefactos locales de publicación y análisis. El APK se publica mediante el
# script oficial y Graphify conserva solo sus salidas principales versionadas.
downloads/
graphify-out/cache/
graphify-out/20??-??-??/
