# .env.example - PLANTILLA de variables de entorno. Sin valores reales, a proposito.
#
# Copiala como ".env" y completala con tus valores:
#     cp .env.example .env
#
# El .env real NO se commitea (esta en .gitignore). Este archivo si va al repo:
# es la unica documentacion de que claves existen y de donde se leen.
# NEVER pegues aca la clave de produccion: asi se filtro una vez.

# ---------------------------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------------------------
# La unica variable realmente obligatoria: sin ella el server no arranca
# (mysql.createPool(undefined)). La leen server.js:67, scripts/migrar.mjs:53 y
# scripts/crear-admin.mjs:26.
# Formato: mysql://USUARIO:CLAVE@HOST:PUERTO/BASE
# En Railway no la copies a mano: el plugin MySQL la inyecta sola.
MYSQL_URL=mysql://tu_usuario_mysql:tu_clave_de_super_secreto@localhost:3306/tu_base

# ---------------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------------
# Puerto del backend (server.js:15). Si lo sacas, usa 3001.
# En Railway lo inyecta el hosting; no hace falta setearlo.
PORT=3001

# Origenes del front con permiso de CORS, separados por coma (server.js:26).
# Con las cookies de sesion httpOnly el navegador exige un origen concreto:
# si el dominio real de produccion no esta aca, el login y el carrito fallan.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# SCRIPT crear-admin (solo local, no hace falta en Railway)
# ---------------------------------------------------------------------------
# Se usa unicamente si no pasas --password (scripts/crear-admin.mjs:55).
# Minimo 8 caracteres (scripts/crear-admin.mjs:62).
ADMIN_PASSWORD=tu_clave_de_super_secreto

# ---------------------------------------------------------------------------
# RECUPERACION DE CUENTA POR EMAIL
# ---------------------------------------------------------------------------
# Resend se usa solo desde el backend. Nunca expongas RESEND_API_KEY al front.
RESEND_API_KEY=re_example_00000000000000000000000000000000
# Remitente verificado en Resend. Usa un dominio propio, no example.invalid.
MAIL_FROM="GuacamayoRecords <no-reply@example.invalid>"
# URL publica a la que apunta el enlace de recuperacion.
PUBLIC_APP_URL=https://app.example.invalid

# ---------------------------------------------------------------------------
# LOGIN CON GOOGLE
# ---------------------------------------------------------------------------
# Backend (auth.js:338): si queda VACIO el server no valida que el token sea
# de esta aplicacion. Tiene que coincidir exactamente con el del front.
GOOGLE_CLIENT_ID=fictitious-google-client-id.apps.example.invalid

# Opcional (auth.js:345): dominios de email autorizados, separados por coma.
# Vacio = cualquiera. Ej: GOOGLE_DOMINIOS=midominio.com,otro.com
GOOGLE_DOMINIOS=example.invalid

# Front (src/components/cuenta/BotonGoogle.tsx:6).
# OJO: las VITE_* se COMPILAN dentro del bundle y son PUBLICAS. Nunca pongas un
# secreto con este prefijo. Si queda vacia el boton de Google se oculta en
# silencio (no hay error visible), y tiene que estar seteada al momento del
# BUILD, no despues.
VITE_GOOGLE_CLIENT_ID=fictitious-public-client-id.apps.example.invalid

# ---------------------------------------------------------------------------
# NODE_ENV lo define el hosting (auth.js:36 lo usa para el modo de sesion).
# No hace falta ponerlo aca; descomentalo solo para desarrollo local.
NODE_ENV=development
